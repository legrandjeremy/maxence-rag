# =============================================================================
# Luna Medium Environment Configuration Example
# =============================================================================
# Copy this file to env.staging, env.prod, etc. and customize for your environment

# =============================================================================
# Environment Configuration
# =============================================================================
ENVIRONMENT=staging

# =============================================================================
# Custom Domain Configuration (Optional)
# =============================================================================
# Set CLOUDFRONT_DOMAIN to use a custom domain with SSL certificate
# Leave empty or comment out to use CloudFront's default domain
CLOUDFRONT_DOMAIN=app.luna-medium.com
# CLOUDFRONT_DOMAIN=  # Use this for default CloudFront domain

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# =============================================================================
# OpenTofu/Terraform State Configuration
# =============================================================================
TF_STATE_BUCKET=staging-tofu-luna-medium
TF_STATE_KEY=staging/tofu.tfstate
TF_STATE_REGION=eu-west-1

# =============================================================================
# Auth0 Configuration
# =============================================================================
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_ISSUER_URL=https://your-auth0-domain.auth0.com/
AUTH0_AUDIENCE=player-management-api
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret
AUTH0_ADMIN_ROLE_ID=rol_admin_role_id
AUTH0_TEAM_MANAGER_ROLE_ID=rol_team_manager_role_id
AUTH0_USER_ROLE_ID=rol_user_role_id

# =============================================================================
# Payment Configuration (Stripe)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# =============================================================================
# WebSocket Configuration
# =============================================================================
LUNA_WS_ENDPOINT=wss://your-websocket-endpoint.execute-api.us-east-1.amazonaws.com/staging/
VITE_LUNA_WS_ENDPOINT=wss://your-websocket-endpoint.execute-api.us-east-1.amazonaws.com/staging/

# =============================================================================
# Frontend Build Configuration
# =============================================================================
# These will be automatically populated by the deployment script
# API_URL=  # Auto-populated from CloudFormation outputs
# CLOUDFRONT_DOMAIN=  # Auto-populated from infrastructure outputs

# =============================================================================
# Optional: Infrastructure Customization
# =============================================================================
# TF_VAR_enable_waf=true  # Enable/disable WAF (default: true when using custom domain)
# TF_VAR_certificate_validation_timeout=5m  # ACM certificate validation timeout
